// Text-only, bewusst: packages.txt installiert JetBrains Mono + Font Awesome,
// aber keine Nerd-Font-Glyphen — Icon-Glyphen würden hier zu Tofu-Boxen führen.
// App-Icons im Workspace-Switcher nutzen deshalb Noto-Emoji (auch aus
// packages.txt) statt Nerd-Font-Glyphen wie in den meisten geteilten Configs.
// battery-Modul blendet sich auf Hosts ohne Akku (cube) von selbst aus.
{
    "layer": "top",
    "position": "top",
    "height": 30,
    "spacing": 4,

    "modules-left": ["hyprland/workspaces", "hyprland/window"],
    "modules-center": ["clock"],
    "modules-right": ["custom/keybinds", "pulseaudio", "bluetooth", "network", "battery", "tray"],

    // Klick öffnet den Geräte-Picker (dot_local/bin/bt). Text statt Glyphe wie überall.
    "bluetooth": {
        "format-off": "BT off",
        "format-on": "BT",
        "format-connected": "BT {device_alias}",
        "tooltip": false,
        // Links: bekanntes Gerät verbinden/trennen. Rechts: neues koppeln.
        "on-click": "~/.local/bin/bt pick",
        "on-click-right": "~/.local/bin/bt pair"
    },

    // Klickbares Gegenstück zu SUPER+F1. Text statt Glyphe, wie der Rest der Bar
    // (kein Nerd Font installiert, s. Kopf dieser Datei).
    "custom/keybinds": {
        "format": "Keys",
        "tooltip": false,
        "on-click": "~/.local/bin/keybinds"
    },

    "hyprland/workspaces": {
        // Immer 1-6 zeigen, auch leer (persistent:true dafür in rules.conf).
        // all-outputs:true heißt auf "book" (2 Monitore): beide Bars zeigen
        // dieselben 6 Buttons — bei Bedarf später per Output aufteilen.
        "format": "{id} {windows}",
        "all-outputs": true,
        "persistent-workspaces": {
            "*": [1, 2, 3, 4, 5, 6]
        },
        "unique-icons": true,
        "window-rewrite-default": "•",
        // Klassen sind Vermutungen — vor dem ersten Vertrauen mit
        // `hyprctl clients` gegenprüfen (Konvention aus rules.conf).
        // Alle Klassen mit `hyprctl clients -j` gegengeprueft (2026-08-21).
        //
        // WICHTIG: waybar matcht den Ausdruck gegen die GANZE Klasse, nicht als
        // Teilstring. Die frueheren Regeln wie class<[Ff]irefox> konnten deshalb
        // nie greifen — die Klasse heisst org.mozilla.firefox. Funktioniert
        // hatten nur foot, cider und ONLYOFFICE, weil dort Muster und Klasse
        // zufaellig identisch waren. Neue Eintraege daher entweder exakt
        // schreiben oder mit .* umschliessen.
        "window-rewrite": {
            "class<foot>": "\ud83d\udda5",
            "class<org\\.mozilla\\.firefox>": "\ud83e\udd8a",
            // thunderbird_esr heute; .* deckt auch den Wechsel auf den
            // Nicht-ESR-Zweig ab.
            "class<org\\.mozilla\\.thunderbird.*>": "\u2709\ufe0f",
            "class<com\\.slack\\.Slack>": "\ud83d\udcac",
            // Element meldet sich als im.riot.Riot — Altlast aus der Riot-Zeit.
            "class<im\\.riot\\.Riot>": "\ud83d\udd37",
            "class<org\\.keepassxc\\.KeePassXC>": "\ud83d\udd11",
            // Die Klasse enthaelt die VERSION ("Apache NetBeans IDE 31"), das .*
            // ist also nicht Kosmetik: ohne es faellt das Icon beim naechsten
            // NetBeans-Major wieder aus.
            "class<Apache NetBeans IDE.*>": "\u2615",
            "class<cider>": "\ud83c\udfb5",
            "class<ONLYOFFICE>": "\ud83d\udcc4",
            // NICHT verifiziert — Signal lief beim Gegenpruefen nicht.
            "class<.*[Ss]ignal.*>": "\ud83d\udd12"
        }
    },
    "hyprland/window": {
        "max-length": 60
    },
    "clock": {
        "format": "{:%H:%M   %a, %d.%m.}"
    },
    "pulseaudio": {
        "format": "Vol {volume}%",
        "format-muted": "Vol muted",
        // Links stummschalten (wie gehabt), rechts das Ausgabegerät wechseln.
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-click-right": "~/.local/bin/audio-out pick"
    },
    "network": {
        "format-wifi": "{essid} {signalStrength}%",
        "format-ethernet": "eth {ipaddr}",
        "format-disconnected": "offline"
    },
    "battery": {
        "format": "Bat {capacity}%",
        "format-charging": "Bat {capacity}% +",
        "states": {
            "warning": 20,
            "critical": 10
        }
    },
    "tray": {
        "spacing": 8
    }
}
