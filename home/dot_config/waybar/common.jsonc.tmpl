// Der GETEILTE Teil der Waybar-Konfiguration: alles, was unter Hyprland und
// unter Sway identisch ist — also die ganze Bar bis auf zwei Module.
//
// Eingebunden per "include" aus:
//   config.jsonc.tmpl        (Hyprland-Session)
//   config-sway.jsonc.tmpl   (Sway-Session)
// Dort steht jeweils nur noch "modules-left" plus der compositor-eigene
// Workspace- und Fenster-Baustein. Waybars Regel dabei: bei doppelten
// Schluesseln gewinnt die EINBINDENDE Datei (Manpage waybar(5), "include").
//
// Diese Datei wird von Waybar NIE direkt geladen — sie hat mit Absicht kein
// "modules-left" und waere allein keine vollstaendige Bar.
//
// Text-only, bewusst: packages.txt installiert JetBrains Mono + Font Awesome,
// aber keine Nerd-Font-Glyphen — Icon-Glyphen würden hier zu Tofu-Boxen führen.
// App-Icons im Workspace-Switcher nutzen deshalb Noto-Emoji (auch aus
// packages.txt) statt Nerd-Font-Glyphen wie in den meisten geteilten Configs.
// battery-Modul blendet sich auf Hosts ohne Akku (cube) von selbst aus.
{
    "layer": "top",
    "position": "top",
    "height": 30,
    "spacing": 4,

    "modules-center": ["clock"],
    "modules-right": ["custom/screenrec", "idle_inhibitor", "custom/keybinds", {{ if eq .chezmoi.hostname "cube" }}"custom/recording", {{ end }}"pulseaudio", "bluetooth", "network", "battery", "tray"],

    // Haelt den Rechner wach, solange laengere Hintergrund-Jobs laufen.
    // Klick schaltet um: "Idle" = normale Kette (5 min Lock, 15 min Suspend),
    // "Wach" = nichts davon.
    //
    // Technik: Waybar haelt dafuer einen zwp_idle_inhibitor_v1 auf seiner
    // eigenen Layer-Surface. Der Compositor stoppt daraufhin die
    // ext-idle-notify-v1-Timer — und genau aus denen speist sich der
    // Idle-Daemon. Es wird also nicht der Daemon gestoppt, sondern ihm die Uhr
    // angehalten; ein `pidof hypridle` sieht weiter alles normal.
    //
    // Gilt unter BEIDEN Compositoren, und zwar aus demselben Grund: der
    // Mechanismus ist reines Standardprotokoll. Unter Hyprland haengt daran
    // hypridle (hypr/hypridle.conf), unter Sway swayidle (sway/base) — beide
    // hoeren auf ext-idle-notify-v1, beide werden hierdurch stillgelegt.
    //
    // Der Zustand liegt bewusst nirgends auf Platte (start-activated bleibt
    // ungesetzt): nach Waybar-Neustart oder Relogin ist der Schutz wieder aus.
    // Ein vergessener Inhibit, der einen Reboot ueberlebt, faellt sonst erst
    // auf, wenn der Akku leer ist.
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "Wach",
            "deactivated": "Idle"
        },
        "tooltip-format-activated": "Kein Lock, kein Suspend — Klick schaltet zurueck",
        "tooltip-format-deactivated": "Lock nach 5 min, Suspend nach 15 min"
    },

    // Klick öffnet den Geräte-Picker (dot_local/bin/bt). Text statt Glyphe wie überall.
    "bluetooth": {
        "format-off": "BT off",
        "format-on": "BT",
        "format-connected": "BT {device_alias}",
        "tooltip": false,
        // Links: bekanntes Gerät verbinden/trennen. Rechts: neues koppeln.
        "on-click": "~/.local/bin/bt pick",
        "on-click-right": "~/.local/bin/bt pair"
    },

    // Klickbares Gegenstück zu SUPER+F1. Text statt Glyphe, wie der Rest der Bar
    // (kein Nerd Font installiert, s. Kopf dieser Datei).
    // Das Skript merkt selbst, welcher Compositor laeuft, und liest die passende
    // binds-Datei — der Aufruf ist in beiden Sessions derselbe.
    "custom/keybinds": {
        "format": "Keys",
        "tooltip": false,
        "on-click": "~/.local/bin/keybinds"
    },

    // Laufende Bildschirmaufnahme (dot_local/bin/record, wf-recorder).
    // NICHT zu verwechseln mit custom/recording weiter unten — das ist der
    // Audio-Aufnahmemodus (Scarlett + CPU). Deshalb auch ein anderes Signal:
    // 8 hier, 7 dort.
    //
    // Auf BEIDEN Hosts, anders als custom/recording: aufnehmen kann man
    // ueberall, dafuer braucht es keine bestimmte Hardware.
    //
    // Ohne Aufnahme liefert `record status` leeren Text — Waybar blendet das
    // Modul dann komplett aus. Es ist also nur zu sehen, wenn es etwas zu
    // sagen hat; ein dauerhaftes "keine Aufnahme" waere reine Bar-Belegung.
    //
    // interval 1, damit die Laufzeit mitzaehlt. Das ist hier vertretbar, weil
    // `record status` bewusst ohne jq, date und cat auskommt (reine
    // Bash-Builtins, s. Kommentar dort) — der Sekundentakt kostet damit
    // nichts. Das Signal ist trotzdem noetig: Start und Stopp sollen sofort
    // stehen, nicht erst nach bis zu einer Sekunde.
    //
    // Kein on-click zum Stoppen: eine laufende Aufnahme per Mausklick auf die
    // Bar zu beenden hiesse, mit dem Zeiger IM Bild herumzufahren. Dafuer sind
    // die drei R-Tasten da.
    "custom/screenrec": {
        "exec": "~/.local/bin/record status",
        "return-type": "json",
        "interval": 1,
        "signal": 8
    },
{{ if eq .chezmoi.hostname "cube" }}
    // Aufnahmemodus (dot_local/bin/recording-mode): schiebt das Scarlett ins
    // pro-audio-Profil und die CPU aus dem Sparmodus — und wieder zurueck.
    // Text statt Glyphe wie der Rest der Bar.
    //
    // NUR AUF DEM CUBE. Das Modul haengt an einem fest angeschlossenen
    // Focusrite und einer Desktop-CPU; auf dem book waere es ein Schalter ins
    // Leere. Die Weiche steht an drei Stellen und muss zusammen gepflegt
    // werden: hier, in .chezmoiignore (das Script selbst) und in bootstrap.sh
    // (Root-Helfer + sudoers-Regel). Das CSS in style.css ist bewusst NICHT
    // gegatet — Regeln fuer ein nicht vorhandenes Modul sind wirkungslos, und
    // eine vierte Weiche waere mehr Risiko als der Gewinn.
    //
    // return-type json, damit ein Aufruf Text, Tooltip UND CSS-Klasse liefert.
    // Der Zustand wird dabei jedes Mal frisch aus PipeWire und /sys gelesen und
    // nirgends zwischengespeichert — ein von Hand mit wpctl umgestelltes Profil
    // oder ein abgezogenes Interface faellt der Anzeige damit sofort auf,
    // statt sie gegen eine gemerkte Wahrheit laufen zu lassen.
    //
    // "signal": 7 muss zu RECMODE_WAYBAR_SIGNAL im Script passen. Nach dem
    // Umschalten schickt das Script pkill -RTMIN+7 waybar, damit die Bar sofort
    // nachzieht; das interval ist nur der Rueckfall fuer Aenderungen, die nicht
    // ueber den Button liefen.
    "custom/recording": {
        "exec": "~/.local/bin/recording-mode status",
        "return-type": "json",
        "interval": 10,
        "signal": 7,
        "on-click": "~/.local/bin/recording-mode toggle"
    },
{{ end }}
    "clock": {
        "format": "{:%H:%M   %a, %d.%m.}"
    },
    "pulseaudio": {
        "format": "Vol {volume}%",
        "format-muted": "Vol muted",
        // Links stummschalten (wie gehabt), rechts das Ausgabegerät wechseln.
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-click-right": "~/.local/bin/audio-out pick"
    },
    // Klick oeffnet den Netz-Picker (dot_local/bin/wifi), analog zum
    // bluetooth-Modul darueber. Rechts: nm-connection-editor fuer statische IP,
    // 802.1X und VPN — alles, was der Picker bewusst nicht kann.
    "network": {
        "format-wifi": "{essid} {signalStrength}%",
        "format-ethernet": "eth {ipaddr}",
        "format-disconnected": "offline",
        "tooltip": false,
        "on-click": "~/.local/bin/wifi pick",
        "on-click-right": "~/.local/bin/wifi edit"
    },
    "battery": {
        "format": "Bat {capacity}%",
        "format-charging": "Bat {capacity}% +",
        "states": {
            "warning": 20,
            "critical": 10
        }
    },
    "tray": {
        "spacing": 8
    }
}
