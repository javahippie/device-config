// Waybar in der HYPRLAND-Session. Der Loewenanteil der Bar steht in
// common.jsonc.tmpl und wird unten per "include" hereingezogen; hier bleibt
// nur, was compositor-spezifisch ist.
//
// Warum ueberhaupt geteilt: seit es die Sway-Session gibt (dot_config/sway),
// braucht es zwei Bar-Konfigurationen, die sich in genau zwei Modulen
// unterscheiden. Eine Datei zu kopieren hiesse, jede kuenftige Aenderung an
// Uhr, Netz, Bluetooth oder Aufnahmemodus doppelt zu pflegen — nach der
// dritten Aenderung waere eine der beiden Bars falsch.
//
// Waybars Include-Regel (waybar(5)): bei doppelten Schluesseln gewinnt die
// EINBINDENDE Datei. Alles hier schlaegt also common.jsonc, nicht umgekehrt.
// Der Pfad ist absolut, weil Waybar in Include-Pfaden kein "~" aufloest;
// chezmoi setzt ihn beim Ausrollen ein.
{
    "include": ["{{ .chezmoi.homeDir }}/.config/waybar/common.jsonc"],

    "modules-left": ["hyprland/workspaces", "hyprland/window"],

    "hyprland/workspaces": {
        // {id} ist die Workspace-Nummer. Das Sway-Modul nennt dasselbe Feld
        // {name} — einer von genau zwei Unterschieden zwischen den Bars.
        "format": "{id} {windows}",
        // Immer 1-6 zeigen, auch leer. Hyprland muss die Workspaces dafuer
        // selbst als persistent kennen, das steht in hypr/rules.conf.tmpl.
        // Schreibweise "*" = auf allen Outputs; das Sway-Modul will hier
        // stattdessen einen Eintrag pro Workspace (s. config-sway.jsonc.tmpl).
        "persistent-workspaces": {
            "*": [1, 2, 3, 4, 5, 6]
        },
{{ template "waybar-workspaces-icons" . }}
    },
    "hyprland/window": {
        "max-length": 60
    }
}
