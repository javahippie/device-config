# Einstiegspunkt fuer Sway — Inhalt lebt in den includeten Dateien.
#
# Aufteilung: Funktion in base/binds/rules, Deko AUSSCHLIESSLICH in effects.
# Das ist die Regel des Repos, und sie gilt hier ohne Ausnahme — wer eine Farbe
# oder einen Rahmen in base sucht, sucht am falschen Ort.
#
# Sway ist seit 10.09.2026 der einzige Compositor. Davor lag daneben eine
# gleich aufgebaute Hyprland-Konfiguration in dot_config/hypr; die Dateinamen
# hier stammen aus dieser Zeit, weshalb sie ohne Endung heissen (Sway braucht
# keine, Hyprland wollte .conf). hypr/ ist seit 13.09.2026 ganz weg — auch
# der Sperrbildschirm ist jetzt swaylock (swaylock/config).
#
# sway bringt seine eigene /usr/share/wayland-sessions/sway.desktop mit, es
# braucht also KEINE Session-Datei im Repo — s. die Begruendung im SDDM-Block
# von bootstrap.sh.
#
# include-Pfade sind relativ zur Datei, die sie einbindet. Hier trotzdem
# absolut geschrieben, damit man sie ohne Nachdenken lesen kann.

include ~/.config/sway/mocha
include ~/.config/sway/base
include ~/.config/sway/monitors
include ~/.config/sway/binds
include ~/.config/sway/rules
include ~/.config/sway/effects
