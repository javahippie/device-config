# Arbeitsfenster sind von jeder Deko ausgenommen, egal was effects.conf treibt.
# Grammatik seit 0.53: EIN match, alle Effekte mit Werten. windowrulev2 existiert nicht mehr.
# Klassen verifizieren: hyprctl clients

windowrule = opacity 1.0 override 1.0 override, no_blur on, no_dim on, match:class ^(Wfica|wfica)$

# Der Rechner schwebt, statt gekachelt zu werden — wie sein Windows-Vorbild und
# aus demselben Grund: er soll neben der Arbeit liegen, nicht die Arbeit
# umschichten. Er bleibt dabei ein normales Fenster, $mod+V holt ihn zurueck in
# die Kachelung.
# Syntax gegen das laufende 0.56 geprueft (hyprctl keyword windowrule -> ok).
# Wichtig ist der Wert hinter jedem Feld: 'float' ohne 'on' quittiert der Parser
# mit "invalid field float: missing a value" — das ist die 0.53-Umstellung.
# Klasse noch mit `hyprctl clients` gegenpruefen, sobald der Rechner einmal lief.
windowrule = float on, size 400 600, center on, match:class ^(org\.gnome\.Calculator)$

# Der lokale Musik-Player schwebt klein, statt als halbes Terminal
# mitgekachelt zu werden — er zeigt eine Laufzeit und einen Balken, mehr hat er
# nicht zu sagen. Gleiche Ueberlegung wie beim Rechner darueber.
#
# Die Klasse ist NICHT foot: das Fenster startet als
# `foot --app-id=mpv-audio` aus dot_local/share/applications/mpv-audio.desktop.
# Ohne die eigene app-id traefe die Regel jedes Terminal.
#
# center statt unten rechts, und das ist ein MESSERGEBNIS, keine Vorliebe:
# `move` nimmt in dieser Grammatik nur absolute Pixel. Live gegen 0.56 probiert
# (hyprctl keyword windowrule + hyprctl clients, Monitor 3440x1440):
#   move 2700 1140              -> at=[2700,1140]   wie gewollt
#   move 100%-740 100%-300      -> at=[1370,605]    zentriert, also ignoriert
#   move 78% 80%                -> at=[1370,605]    dito
#   move onscreen 100%-740 ...  -> at=[1370,605]    dito
#   move cursor -50% -50%       -> at=[1370,605]    dito
# Kein Fehler, kein Eintrag in `hyprctl configerrors` — die Regel faellt einfach
# still auf die Standardplatzierung zurueck. Absolute Pixel waeren auf dem cube
# richtig und auf dem book (andere Aufloesung) daneben, deshalb center: das
# rechnet Hyprland selbst und gilt auf beiden Hosts.
# $mod+V holt das Fenster in die Kachelung zurueck, wie beim Rechner.
windowrule = float on, size 700 260, center on, match:class ^(mpv-audio)$

# Waybars persistent-workspaces (config.jsonc) zeigt 1-6 nur zuverlässig an,
# wenn Hyprland selbst die Workspaces als persistent kennt.
workspace = 1, persistent:true
workspace = 2, persistent:true
workspace = 3, persistent:true
workspace = 4, persistent:true
workspace = 5, persistent:true
workspace = 6, persistent:true
{{ if eq .chezmoi.hostname "cube" }}
# --- Fester Startplatz pro App (nur cube) ---
# Jede App kommt beim OEFFNEN auf ihren Workspace. Das ist eine Fensterregel,
# kein Autostart und kein Pinning: sie greift genau einmal, im Moment des
# Fensteroeffnens. Wer danach mit $mod+SHIFT+<n> umsortiert, behaelt das --
# Hyprland wendet die Regel auf ein bereits offenes Fenster nicht erneut an.
#
# BEWUSST OHNE `silent`: der Workspace wird mitgewechselt, man landet also bei
# dem Programm, das man gerade gestartet hat. Wer eine App lieber im
# Hintergrund aufgehen laesst, haengt an ihre Zeile ein `silent` an
# (`workspace 3 silent`). Beide Formen gegen das laufende 0.56 geprueft
# (hyprctl keyword windowrule -> ok, keine configerrors).
#
# foot steht hier bewusst NICHT: das Terminal soll dort aufgehen, wo man
# gerade ist.
#
# Nur auf dem cube, weil die Aufteilung an diesem Arbeitsplatz haengt (Citrix
# fuer den Kunden, ein Monitor). Das book verteilt Workspaces auf zwei
# Monitore (s. monitors.conf.tmpl) und braucht eine eigene Aufteilung, sobald
# sie feststeht.
#
# Klassen mit `hyprctl clients -j` gegengeprueft (08.09.2026).
# Workspace 5 bleibt absichtlich leer: Platz zum Ausbreiten.
windowrule = workspace 1, match:class ^(org\.mozilla\.firefox)$
# Citrix: dieselbe Klasse wie die Deko-Ausnahme ganz oben. Bewusst zwei
# getrennte Regeln -- die Deko-Regel gilt auf jedem Host, dieser Platz nur hier.
windowrule = workspace 2, match:class ^(Wfica|wfica)$
# thunderbird_esr heute; .* deckt den Wechsel auf den Nicht-ESR-Zweig ab
# (gleiche Ueberlegung wie beim Icon in waybar/config.jsonc.tmpl).
windowrule = workspace 3, match:class ^(org\.mozilla\.thunderbird.*)$
windowrule = workspace 4, match:class ^(com\.slack\.Slack)$
# Element meldet sich als im.riot.Riot -- Altlast aus der Riot-Zeit.
windowrule = workspace 4, match:class ^(im\.riot\.Riot)$
# KeePassXC lief beim Gegenpruefen nicht; Klasse aus der bereits verifizierten
# window-rewrite-Liste in waybar/config.jsonc.tmpl uebernommen.
windowrule = workspace 6, match:class ^(org\.keepassxc\.KeePassXC)$
{{- end }}
