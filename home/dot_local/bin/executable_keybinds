#!/usr/bin/env bash
# Zeigt die Tastenbelegung als durchsuchbares fuzzel-Popup.
#
# Quelle ist die binds-Datei SELBST, keine zweite gepflegte Liste — eine
# Übersicht, die man von Hand nachziehen muss, ist nach dem dritten neuen
# Binding falsch. Auch die "# --- Abschnitt ---"-Kommentare aus der Datei werden
# übernommen, die Gliederung steht also ebenfalls nur an einer Stelle.
#
# Bis 10.09.2026 konnte das Skript zwei Syntaxen (Hyprlands "bind = $mod, D, exec, …"
# und Sways "bindsym $mod+d exec …") und suchte sich anhand der laufenden Session
# die passende aus. Hyprland ist weg, damit auch der Zweig — geblieben ist die
# Sway-Variante.
#
# Bewusst nicht `swaymsg -t get_binding_modes` o. ä.: das kennt zwar den
# Live-Zustand, liefert aber Modmasken statt Namen und hat keine Abschnitte.
# Der Unterschied fällt nur auf, wenn man Bindings zur Laufzeit ändert — dann
# fehlen sie hier.
set -euo pipefail

# KEYBINDS_CONF uebersteuert den Pfad — praktisch, um eine andere binds-Datei
# anzusehen, ohne sie an ihren Platz zu legen. HYPR_BINDS gab es hier bis
# 10.09.2026 als zweite Variable; sie ist mit Hyprland weggefallen.
detect_conf() {
    printf '%s' "${KEYBINDS_CONF:-$HOME/.config/sway/binds}"
}

CONF="$(detect_conf)"
[ -f "$CONF" ] || { echo "keybinds: nicht gefunden: $CONF" >&2; exit 1; }

# --- bindsym [--flags] MOD+TASTE befehl argumente ---
format_sway() {
    awk '
        function trim(s) { gsub(/^[ \t]+|[ \t]+$/, "", s); return s }

        # Abschnitte kommen aus den "# --- X ---"-Kommentaren der binds-Datei.
        /^[ \t]*#[ \t]*---/ {
            h = $0
            sub(/^[ \t]*#[ \t]*---[ \t]*/, "", h)
            sub(/[ \t]*---.*$/, "", h)
            section = trim(h)
            next
        }

        # bindsym, nicht bindcode: das Repo bindet ausschliesslich Keysyms.
        # Ein bindcode wuerde hier durchfallen — dann bitte hier mit aufnehmen.
        /^[ \t]*bindsym[ \t]/ {
            line = $0
            sub(/^[ \t]*bindsym[ \t]+/, "", line)

            # Flags abraeumen (--locked, --to-code, --no-repeat, ...). Sie sagen
            # etwas ueber die Bindung, nicht ueber die Taste, und wuerden die
            # Spalte nur breit machen.
            while (line ~ /^--[a-zA-Z-]+[ \t]+/) sub(/^--[a-zA-Z-]+[ \t]+/, "", line)

            # Erstes Feld = Tastenkombination, Rest = Befehl.
            combo = line; sub(/[ \t].*$/, "", combo)
            what  = line; sub(/^[^ \t]+[ \t]+/, "", what)

            gsub(/\$mod/, "SUPER", combo)
            gsub(/\+/, " + ", combo)
            # Modifier gross schreiben: Sway notiert sie klein bzw. gemischt,
            # in der Uebersicht sollen sie einheitlich aussehen.
            gsub(/Shift/, "SHIFT", combo)
            gsub(/Ctrl/, "CTRL", combo)
            gsub(/Alt/, "ALT", combo)
            # Einzelbuchstaben ebenfalls gross (Sway notiert "q").
            if (combo ~ / \+ [a-z]$/) combo = substr(combo, 1, length(combo) - 1) toupper(substr(combo, length(combo)))

            if (what ~ /^exec[ \t]/) {
                sub(/^exec[ \t]+/, "", what)
                # $qtenv ist ein Sway-Variablen-Praefix aus sway/base und nur
                # Technik (Qt-Theme fuer Double Commander) — in einer
                # Tastenuebersicht ist es Rauschen.
                sub(/^\$qtenv[ \t]+/, "", what)
                sub(/^~\/\.local\/bin\//, "", what)   # eigene Skripte kurz halten
            }
            what = trim(what)

            if (section != last_section) {
                if (NR > 1 && printed) print ""
                print "── " section
                last_section = section
            }
            printed = 1
            printf "   %-24s %s\n", combo, what
        }
    ' "$1"
}

format_sway "$CONF" | fuzzel --dmenu --prompt 'Keybinds: ' --width 72 >/dev/null || true
