#!/usr/bin/env bash
# Aufnahmemodus umschalten — Scarlett auf Pro Audio, CPU aus dem Sparmodus.
#
# Zwei Zustände, ein Schalter:
#
#   off  "Alltag"    Scarlett als normales Interface (Surround-Profil, ein
#                    Stereo-Sink, eine Quelle). Meetings, Musik, Systemton
#                    funktionieren wie gewohnt, RNNoise hängt am Mikrofon.
#                    CPU im powersave/balance_performance, C-States frei.
#
#   on   "Aufnahme"  Scarlett im pro-audio-Profil: rohes hw:0, alle 10 Ein- und
#                    6 Ausgänge als Einzelports, keine ALSA-Plugin- und keine
#                    Channel-Remap-Schicht dazwischen. CPU auf performance,
#                    tiefe C-States aus.
#
# Warum das ein SCHALTER ist und keine Dauereinstellung: pro-audio ist für
# Meetings unbrauchbar. Das Profil liefert bewusst keinen fertigen Stereo-Sink,
# sondern nackte Ports — Slack, Firefox & Co. finden darin kein Ausgabegerät,
# das sie ohne Handarbeit bespielen könnten. Genau deshalb stuft WirePlumber
# pro-audio auch mit Priorität 1 ein (das Surround-Profil hat 1301) und wählt es
# nie von selbst.
#
# Der CPU-Teil braucht root und liegt deshalb in einem separaten Helfer
# (/usr/local/bin/recording-mode-cpu), der über eine eng gefasste
# sudoers-Regel ohne Passwort läuft. Der Scarlett-Teil braucht kein root —
# wpctl redet über den Session-Bus mit WirePlumber.
set -euo pipefail

CARD="${RECMODE_CARD:-Scarlett 8i6 USB}"
PRO_PROFILE="pro-audio"
# Das Profil, in das 'off' zurückschaltet. Ist bewusst überschreibbar: wer sein
# Interface lieber als reines Stereo fährt, setzt hier z. B.
# output:analog-stereo+input:multichannel-input.
NORMAL_PROFILE="${RECMODE_NORMAL_PROFILE:-output:analog-surround-21+input:multichannel-input}"
HELPER="${RECMODE_HELPER:-/usr/local/bin/recording-mode-cpu}"
# Muss zum "signal" im waybar-Modul passen (dort 7 -> hier 7).
SIGNAL="${RECMODE_WAYBAR_SIGNAL:-7}"

for tool in pw-dump wpctl jq; do
    command -v "$tool" >/dev/null 2>&1 || {
        echo "recording-mode: $tool fehlt (pipewire-utils / wireplumber / jq)" >&2
        exit 1
    }
done

usage() {
    cat <<EOF
Usage: recording-mode [toggle|on|off|status|state]

  toggle    Zwischen Alltag und Aufnahme umschalten (Default ohne Argument)
  on        Aufnahmemodus an
  off       Zurück in den Alltagsmodus
  status    JSON für das waybar-Modul custom/recording
  state     Nur "on", "off", "partial" oder "absent" auf stdout

Umgebung:
  RECMODE_CARD             ALSA-Kartenname (Default "$CARD")
  RECMODE_NORMAL_PROFILE   Profil für 'off' (Default "$NORMAL_PROFILE")
EOF
}

# --- Zustand einlesen -------------------------------------------------------
#
# EIN pw-dump pro Aufruf, danach nur noch jq auf dem Ergebnis. Nicht aus
# Sparsamkeit, sondern wegen Konsistenz: drei einzelne pw-dump-Aufrufe könnten
# drei verschiedene Graph-Zustände sehen, wenn gerade jemand ein Gerät ansteckt.
snapshot() {
    PW_DUMP="$(pw-dump 2>/dev/null || echo '[]')"
    DEV_ID="$(jq -r --arg c "$CARD" '
        [ .[]
          | select(.type == "PipeWire:Interface:Device")
          | select(.info.props["api.alsa.card.name"] == $c)
          | .id ][0] // empty' <<<"$PW_DUMP")"

    if [ -n "$DEV_ID" ]; then
        ACTIVE_PROFILE="$(jq -r --argjson id "$DEV_ID" '
            [ .[] | select(.id == $id) | .info.params.Profile[]? | .name ][0] // empty' <<<"$PW_DUMP")"
    else
        ACTIVE_PROFILE=""
    fi
}

# Profilnamen -> Index. Absichtlich über den NAMEN gesucht und nicht als Zahl
# fest verdrahtet: die Indizes stammen aus der Profilliste des Geräts, und die
# hängt an Treiber- und WirePlumber-Version.
profile_index() {
    jq -r --argjson id "$DEV_ID" --arg n "$1" '
        [ .[] | select(.id == $id) | .info.params.EnumProfile[]?
          | select(.name == $n) | .index ][0] // empty' <<<"$PW_DUMP"
}

cpu_mode() {
    local gov
    gov="$(cat /sys/devices/system/cpu/cpufreq/policy0/scaling_governor 2>/dev/null || echo unknown)"
    if [ "$gov" = performance ]; then echo on; else echo off; fi
}

# Gesamtzustand. "partial" ist kein Schönheitsfehler, sondern der Fall, der
# wehtut: Scarlett im Aufnahmeprofil, CPU aber noch im Sparmodus (oder
# umgekehrt) — etwa weil der sudo-Helfer fehlt. Das soll man in der Bar sehen.
state() {
    local audio cpu
    [ -n "$DEV_ID" ] || { echo absent; return; }
    if [ "$ACTIVE_PROFILE" = "$PRO_PROFILE" ]; then audio=on; else audio=off; fi
    cpu="$(cpu_mode)"
    if [ "$audio" = "$cpu" ]; then echo "$audio"; else echo partial; fi
}

signal_waybar() {
    pkill -RTMIN+"$SIGNAL" waybar 2>/dev/null || true
}

note() {
    if command -v notify-send >/dev/null 2>&1; then
        notify-send -a "recording-mode" -t 3000 "$1" "${2:-}" || true
    fi
}

# --- Schalten ---------------------------------------------------------------

set_profile() {
    local want="$1" idx
    idx="$(profile_index "$want")"
    [ -n "$idx" ] || { echo "recording-mode: Profil '$want' kennt das Gerät nicht" >&2; return 1; }
    [ "$ACTIVE_PROFILE" = "$want" ] && return 0
    wpctl set-profile "$DEV_ID" "$idx"
}

set_cpu() {
    if [ ! -x "$HELPER" ]; then
        echo "recording-mode: $HELPER fehlt — nur das Audioprofil wurde geschaltet." >&2
        echo "                Helfer + sudoers-Regel installieren, s. Kommentarkopf." >&2
        return 1
    fi
    # -n: lieber hier hart scheitern als einen Passwort-Prompt in einen
    # Waybar-Klick zu hängen, den niemand jemals zu Gesicht bekommt.
    sudo -n "$HELPER" "$1"
}

# Nach dem Zurückschalten wieder zum Standardgerät machen. WirePlumber holt das
# meist von selbst nach, aber "meist" ist zu wenig, wenn gleich ein Meeting
# beginnt. Der Knoten braucht einen Moment, bis er im Graphen auftaucht —
# daher die kurze Warteschleife statt eines blinden sleep.
restore_default_sink() {
    local i sink
    for i in $(seq 10); do
        sink="$(pw-dump 2>/dev/null | jq -r --arg c "$CARD" '
            [ .[]
              | select(.type == "PipeWire:Interface:Node")
              | select(.info.props["api.alsa.card.name"] == $c)
              | select(.info.props["media.class"] == "Audio/Sink")
              | .id ][0] // empty')"
        if [ -n "$sink" ]; then
            wpctl set-default "$sink" 2>/dev/null || true
            return 0
        fi
        sleep 0.3
    done
    return 0
}

cmd_on() {
    local rc=0
    set_profile "$PRO_PROFILE" || rc=1
    set_cpu on || rc=1
    signal_waybar
    if [ "$rc" -eq 0 ]; then
        note "Aufnahmemodus an" "Scarlett: Pro Audio · CPU: performance, C3 aus"
    else
        note "Aufnahmemodus unvollständig" "Details: recording-mode on im Terminal"
    fi
    return "$rc"
}

cmd_off() {
    local rc=0
    set_profile "$NORMAL_PROFILE" || rc=1
    restore_default_sink
    set_cpu off || rc=1
    signal_waybar
    if [ "$rc" -eq 0 ]; then
        note "Alltagsmodus" "Scarlett: Surround 2.1 · CPU: powersave"
    else
        note "Umschalten unvollständig" "Details: recording-mode off im Terminal"
    fi
    return "$rc"
}

cmd_status() {
    local s text class tip cpu
    s="$(state)"
    cpu="$(cpu_mode)"
    case "$s" in
        on)
            text="Rec"; class="active"
            tip="Aufnahmemodus — Scarlett auf Pro Audio, CPU auf performance, C3 aus. Klick: zurueck in den Alltagsmodus" ;;
        off)
            text="Rec off"; class="idle"
            tip="Alltagsmodus — Scarlett als normales Interface, CPU im Sparmodus. Klick: Aufnahmemodus an" ;;
        partial)
            text="Rec ?!"; class="partial"
            tip="Halb geschaltet: Profil '${ACTIVE_PROFILE:-?}', CPU $cpu. Klick schaltet komplett um" ;;
        absent)
            text="Rec —"; class="absent"
            tip="$CARD nicht gefunden — Interface angeschlossen?" ;;
    esac
    jq -nc --arg t "$text" --arg c "$class" --arg tip "$tip" --arg alt "$s" \
        '{text:$t, class:$c, tooltip:$tip, alt:$alt}'
}

# --- Einstieg ---------------------------------------------------------------
case "${1:-toggle}" in
    on)     snapshot; cmd_on ;;
    off)    snapshot; cmd_off ;;
    # 'partial' zaehlt hier bewusst als "aus machen", nicht als "nochmal
    # versuchen". Ein halb geschalteter Zustand kommt praktisch immer daher,
    # dass der CPU-Helfer fehlt oder die sudoers-Regel nicht greift — ein
    # zweiter Versuch scheitert dann an derselben Stelle, und der Button waere
    # eine Sackgasse. Der Klick fuehrt deshalb zurueck in den bekannten
    # Alltagszustand; das Reparieren des Helfers ist keine Aufgabe fuer einen
    # Mausklick.
    toggle) snapshot
            case "$(state)" in
                on|partial) cmd_off ;;
                *)          cmd_on ;;
            esac ;;
    status) snapshot; cmd_status ;;
    state)  snapshot; state ;;
    -h|--help|help) usage ;;
    *)      usage >&2; exit 2 ;;
esac
