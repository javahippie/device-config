# ~/.bash_profile — TTY1-Login startet die Sway-Session, ABER nur als Notfallpfad.
#
# Regulär übernimmt SDDM den Session-Start (s. README "Login-Screen"). Der Block
# unten greift nur, wenn sddm.service NICHT läuft — also wenn der Display-Manager
# kaputt ist und man auf einem TTY landet. Dann kommt man wie früher direkt in
# die Session, statt vor einem toten System zu stehen.
#
# `exec sway` direkt, ohne Wrapper: Sway macht sein Session- und D-Bus-Setup
# selbst (dbus-update-activation-environment steht in sway/base). Hier stand bis
# 10.09.2026 `exec start-hyprland` — der Wrapper kam aus dem Hyprland-Paket und
# ist mit ihm verschwunden.
#
# TTY2+ bleibt bewusst compositor-frei: das ist der Debug-Ausgang.

[ -f ~/.bashrc ] && . ~/.bashrc

if [ -z "$WAYLAND_DISPLAY" ] && [ "$(tty)" = "/dev/tty1" ] \
   && ! systemctl is-active --quiet sddm.service; then
    exec sway
fi
