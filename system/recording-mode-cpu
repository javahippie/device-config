#!/usr/bin/env bash
# Root-Helfer für 'recording-mode' — schaltet die CPU zwischen Spar- und
# Aufnahmebetrieb. Wird ausschliesslich per sudo aus ~/.local/bin/recording-mode
# aufgerufen, siehe /etc/sudoers.d/recording-mode.
#
# WARUM EIN EIGENER HELFER, statt dem Nutzer sudo auf tee/cpupower zu geben:
# eine sudoers-Regel mit NOPASSWD ist genau so sicher wie das, was sie erlaubt.
# "darf mit tee nach /sys schreiben" ist effektiv Root. Dieses Script nimmt
# genau zwei Argumente entgegen, kennt nur feste Zielwerte und fasst nichts
# ausserhalb von cpufreq/cpuidle an. Damit ist die Regel eng genug.
#
# WICHTIG: Die Datei muss root:root und darf NICHT für den Nutzer schreibbar
# sein (0755). Wäre sie es, könnte der Nutzer ihren Inhalt austauschen und sie
# per NOPASSWD-Regel als root ausführen — das wäre eine Rechteausweitung mit
# einem Extraschritt. 'install -o root -g root -m 0755' erledigt das richtig.
set -euo pipefail

# C-States oberhalb dieser Aufweckzeit werden im Aufnahmemodus abgeschaltet.
# Auf einem Ryzen 9 7900 heisst das konkret C3 (350 us Exit-Latenz) — bei 128
# Samples @ 48 kHz sind das rund 13 % des gesamten Zeitbudgets eines Zyklus,
# ausgerechnet dann fällig, wenn der Kern aus dem Leerlauf geweckt wird. C1
# (1 us) und C2 (18 us) bleiben an; die kosten nichts und sparen echte Wärme.
LATENCY_MAX_US="${RECMODE_CSTATE_MAX_US:-100}"

case "${1:-}" in
    on)  GOVERNOR=performance; EPP=performance;         DISABLE_DEEP=1 ;;
    off) GOVERNOR=powersave;   EPP=balance_performance; DISABLE_DEEP=0 ;;
    *)   echo "Usage: $(basename "$0") on|off" >&2; exit 2 ;;
esac

[ "$(id -u)" -eq 0 ] || { echo "$(basename "$0"): braucht root" >&2; exit 1; }

# amd-pstate-epp kennt beide Stellschrauben getrennt: der Governor entscheidet
# ueber den Taktbereich, die EPP ueber die Aggressivitaet innerhalb dessen. Nur
# den Governor auf performance zu setzen und die EPP auf balance_performance
# stehen zu lassen, waere ein halber Schritt.
for policy in /sys/devices/system/cpu/cpufreq/policy*; do
    [ -d "$policy" ] || continue
    if [ -w "$policy/scaling_governor" ]; then
        echo "$GOVERNOR" > "$policy/scaling_governor" || true
    fi
    if [ -w "$policy/energy_performance_preference" ]; then
        echo "$EPP" > "$policy/energy_performance_preference" || true
    fi
done

# Ueber die gemessene Latenz filtern statt ueber den Namen: "C3" heisst nicht
# auf jeder CPU dasselbe, die Zahl in latency schon.
for state in /sys/devices/system/cpu/cpu*/cpuidle/state*; do
    [ -d "$state" ] || continue
    [ -r "$state/latency" ] || continue
    lat="$(cat "$state/latency")"
    if [ "$lat" -gt "$LATENCY_MAX_US" ] && [ -w "$state/disable" ]; then
        echo "$DISABLE_DEEP" > "$state/disable" || true
    fi
done

gov_now="$(cat /sys/devices/system/cpu/cpufreq/policy0/scaling_governor 2>/dev/null || echo '?')"
epp_now="$(cat /sys/devices/system/cpu/cpufreq/policy0/energy_performance_preference 2>/dev/null || echo '?')"
echo "recording-mode-cpu: $1 — governor=$gov_now epp=$epp_now deep-cstates=$([ "$DISABLE_DEEP" = 1 ] && echo aus || echo an)"
